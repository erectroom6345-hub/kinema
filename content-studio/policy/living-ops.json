{
  "version": 3,
  "genre": "living",
  "label": "暮らし便利グッズ",
  "affiliate": "rakuten_only",
  "account": "genre_dedicated",
  "posting": {
    "perDay": 1,
    "requirePr": true,
    "cta": "ig_self_contained",
    "ctaNotes": {
      "instagram": "投稿内完結（保存CTA）。ブログ誘導なし。1枚目は商品写真",
      "threads": "SNS完結: 楽天アフィリエイトURL直載せ。ブログ誘導なし。tipはURLなし",
      "x": "SNS完結: 楽天アフィリエイトURL直載せ。ブログ誘導なし。tipはURLなし",
      "blog": "カテゴリまとめ専用。SNSからの誘導先にしない（美容だけブログ誘導）"
    },
    "platforms": [
      "instagram",
      "threads",
      "x"
    ],
    "noDmCommentReplyCta": true
  },
  "tipPosts": {
    "enabled": true,
    "weekday": "sat",
    "requirePr": false,
    "catalogPath": "input/products-living-tips.json",
    "description": "土曜はアフィ無しで、答えやすい質問を1つと自分の習慣を1つ（週1）。商品URLなし・※PRなし。"
  },
  "snsCopy": {
    "beats": [
      "悩み",
      "変化",
      "根拠",
      "行動"
    ],
    "maxLines": 5,
    "prToken": "※PR",
    "instagramAction": "気になったら、保存して見返してみてください"
  },
  "categories": [
    "kitchen",
    "storage",
    "cleaning",
    "other"
  ],
  "categorySchedule": {
    "timezone": "Asia/Tokyo",
    "weekly": {
      "mon": "kitchen",
      "tue": "cleaning",
      "wed": "storage",
      "thu": "kitchen",
      "fri": "cleaning",
      "sat": "other",
      "sun": "kitchen"
    },
    "weeklyCountsTarget": {
      "kitchen": 3,
      "cleaning": 2,
      "storage": 1,
      "other": 1
    },
    "minCategoryGapDays": 1,
    "fallbackOrder": [
      "kitchen",
      "cleaning",
      "storage",
      "other"
    ]
  },
  "interrupt": {
    "enabled": true,
    "maxPerWeek": 2,
    "priority": [
      "campaign",
      "sale"
    ],
    "respectCategoryGap": true,
    "description": "sale/campaign は週最大2回まで曜日予定を上書き。popular は通常枠内の優先度のみ。"
  },
  "productRules": {
    "priceMinYen": 300,
    "priceMaxYen": 20000,
    "preferredPriceMinYen": 800,
    "preferredPriceMaxYen": 8000,
    "highTicket": {
      "priceMaxYen": 100000,
      "categories": [],
      "namePatterns": [
        "防災",
        "ソーラー",
        "蓄電",
        "発電機",
        "非常用",
        "熊よけ",
        "クマよけ",
        "クマ撃退",
        "携帯トイレ",
        "簡易トイレ"
      ],
      "description": "床300円は維持。通常天井2万。防災・獣害・stockpile/demand は10万まで通す。"
    },
    "productCoolDownDays": 14,
    "requiredFields": [
      "id",
      "name",
      "category",
      "description",
      "priceRange",
      "features",
      "rakutenUrl",
      "imageUrl"
    ],
    "labelFields": {
      "sale": "boolean — セール品",
      "campaign": "boolean — キャンペーン中",
      "popular": "boolean — 人気/定番（通常枠で優先）",
      "campaignEndAt": "ISO日付 — キャンペーン終了日（過ぎたら出さない）",
      "saleEndAt": "ISO日付 — セール終了日（任意）"
    }
  },
  "growth": {
    "windowHours": 48,
    "primaryPlatform": "threads",
    "likeMedianMultiplier": 2,
    "recentWindow": 20,
    "minRepliesPlusQuotes": 3
  },
  "blog": {
    "mode": "category_roundup",
    "seedPerCategory": 2,
    "appendOnlyOnHit": true,
    "splitAfterProducts": 15,
    "roundupTitles": {
      "kitchen": "キッチン用品まとめ",
      "storage": "収納グッズまとめ",
      "cleaning": "掃除グッズまとめ",
      "other": "暮らしの便利グッズまとめ"
    }
  }
}
