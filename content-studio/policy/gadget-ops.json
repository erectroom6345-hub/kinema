{
  "version": 1,
  "genre": "gadget",
  "label": "ガジェット小物",
  "affiliate": "rakuten_only",
  "account": "genre_dedicated",
  "posting": {
    "perDay": 1,
    "requirePr": true,
    "cta": "ig_self_contained",
    "ctaNotes": {
      "instagram": "投稿内完結（保存CTA）。ブログ誘導なし。1枚目は商品写真",
      "threads": "通常: 楽天アフィリエイトURL直載せ。備蓄期間のみ備えまとめページURL。tipはURLなし",
      "x": "通常: 楽天アフィリエイトURL直載せ。備蓄期間のみ備えまとめページURL。tipはURLなし",
      "blog": "カテゴリまとめ専用。通常はSNS誘導なし。備蓄期間だけガジェットSNSから備えページへ"
    },
    "platforms": [
      "instagram",
      "threads",
      "x"
    ],
    "noDmCommentReplyCta": true
  },
  "tipPosts": {
    "enabled": true,
    "weekday": "sat",
    "requirePr": false,
    "catalogPath": "input/products-gadget-tips.json",
    "description": "土曜はアフィ無しで、答えやすい質問を1つと自分の習慣を1つ（週1）。商品URLなし・※PRなし。"
  },
  "stockpilePeriod": {
    "enabled": true,
    "start": "2026-10-28",
    "end": "2026-11-30",
    "snsDestination": "blog",
    "preferredCategories": ["other", "power"],
    "description": "家庭備蓄の呼びかけ期間（food+gadget）。Threads/X は備えまとめページURL。携帯トイレ・電灯・ラジオ・電源を多めに。GADGET_STOCKPILE_MODE で強制ON/OFF。",
    "copyNotes": "家庭の備え・停電時・携帯トイレなど検索されやすい語を本文に1つ。デスク系の普段顔は残しつつ備え枠を優先。"
  },
  "snsCopy": {
    "beats": [
      "悩み",
      "変化",
      "根拠",
      "行動"
    ],
    "maxLines": 5,
    "prToken": "※PR",
    "instagramAction": "気になったら、保存して見返してみてください"
  },
  "categories": [
    "power",
    "cable",
    "desk",
    "audio",
    "phone",
    "other"
  ],
  "categorySchedule": {
    "timezone": "Asia/Tokyo",
    "weekly": {
      "mon": "power",
      "tue": "desk",
      "wed": "cable",
      "thu": "audio",
      "fri": "phone",
      "sat": "other",
      "sun": "desk"
    },
    "weeklyCountsTarget": {
      "power": 1,
      "desk": 2,
      "cable": 1,
      "audio": 1,
      "phone": 1,
      "other": 1
    },
    "minCategoryGapDays": 1,
    "fallbackOrder": [
      "power",
      "desk",
      "cable",
      "audio",
      "phone",
      "other"
    ]
  },
  "interrupt": {
    "enabled": true,
    "maxPerWeek": 2,
    "priority": [
      "campaign",
      "sale"
    ],
    "respectCategoryGap": true,
    "description": "sale/campaign は週最大2回まで曜日予定を上書き。popular は通常枠内の優先度のみ。"
  },
  "productRules": {
    "priceMinYen": 300,
    "priceMaxYen": 20000,
    "preferredPriceMinYen": 800,
    "preferredPriceMaxYen": 8000,
    "highTicket": {
      "priceMaxYen": 100000,
      "categories": ["power"],
      "namePatterns": [
        "ソーラー",
        "ポータブル電源",
        "蓄電池",
        "蓄電",
        "発電機",
        "非常用電源",
        "防災",
        "手回し",
        "ランタン"
      ],
      "description": "床300円は維持。通常天井2万。電源・防災・stockpile/demand は10万まで通す（需要・希少優先）。"
    },
    "productCoolDownDays": 14,
    "requiredFields": [
      "id",
      "name",
      "category",
      "description",
      "priceRange",
      "features",
      "rakutenUrl",
      "imageUrl"
    ],
    "labelFields": {
      "sale": "boolean — セール品",
      "campaign": "boolean — キャンペーン中",
      "popular": "boolean — 人気/定番（通常枠で優先）",
      "campaignEndAt": "ISO日付 — キャンペーン終了日（過ぎたら出さない）",
      "saleEndAt": "ISO日付 — セール終了日（任意）"
    }
  },
  "growth": {
    "windowHours": 48,
    "primaryPlatform": "threads",
    "likeMedianMultiplier": 2,
    "recentWindow": 20,
    "minRepliesPlusQuotes": 3
  },
  "blog": {
    "mode": "category_roundup",
    "seedPerCategory": 2,
    "appendOnlyOnHit": true,
    "splitAfterProducts": 15,
    "roundupTitles": {
      "power": "充電・電源ガジェットまとめ",
      "cable": "ケーブル・配線まわりまとめ",
      "desk": "デスク周りのガジェットまとめ",
      "audio": "イヤホン・オーディオ小物まとめ",
      "phone": "スマホ周辺ガジェットまとめ",
      "other": "ガジェット小物まとめ"
    }
  }
}
