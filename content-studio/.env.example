# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# LLM: ollama | openai | template（未設定時は ollama）
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# 手動実行の生成待ち（旧600000は朝遅延の主因。既定180s）
OLLAMA_TIMEOUT_MS=180000
OLLAMA_WARMUP_TIMEOUT_MS=60000
# 朝ラン（launchd は BEAUTY_MORNING_MODE=true / 手動は auto=8-10時JST）
# 目標: 9:00開始 → 9:15〜9:25完了。冷起動回避のため朝も予熱→生成（超過時フォールバック）
BEAUTY_MORNING_MODE=auto
# launchd は BEAUTY_MORNING_MODE=true を渡す。.env の auto で上書きされない（run-beauty が保護）
OLLAMA_MORNING_TIMEOUT_MS=90000
OLLAMA_MORNING_WARMUP_TIMEOUT_MS=45000
OLLAMA_MORNING_SKIP_WARMUP=false
# 未投稿0件時: recycle（既定・本番適格の最古投稿を再利用） / skip（投稿せず終了）
BEAUTY_EMPTY_FALLBACK=recycle
# Ollama失敗時にテンプレcaptionへ落とす（投稿停止を防ぐ。止めるなら false）
OLLAMA_CAPTION_FALLBACK=true

# openai 利用時のみ必要。未設定でも ollama / template なら動作する
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# true のときだけ既存 blogUrl を再利用して Blogger 新規公開をスキップ（既定は毎回新規公開）
# BLOGGER_REUSE_EXISTING_URL=false
# true のとき caption/Threads に商品名を自動補完（テスト用。本番は false 推奨）
# CAPTION_AUTO_FILL_PRODUCT=false

# ---- 美容 選定モード（本番 / テスト / recycle 完全分離）----
# 本番（朝9時 launchd → run-beauty.sh）:
#   CONTENT_STUDIO_ENV=production（未設定も production 扱い）
#   ・未投稿のみ選定。在庫0なら停止（recycle に落ちない）
#   ・以下が true だと起動時に即エラー:
#       BEAUTY_TEST_MODE / BEAUTY_ALLOW_RECYCLE / BEAUTY_USE_REPOST
#       BEAUTY_SKIP_SELECT / BEAUTY_SIMULATE_* / BEAUTY_ALLOW_TEST_PIPELINE
# CONTENT_STUDIO_ENV=production
#
# 意図的テスト（本番 launchd には絶対に書かない）:
#   CONTENT_STUDIO_ENV=test
#   → data/posted-beauty.test.json を使用 / --simulate-* 許可
#   または: BEAUTY_ALLOW_TEST_PIPELINE=true bash run-beauty.sh
#
# recycle（手動/別スケジュールのみ）:
#   npm run beauty:recycle          # 選定のみ
#   npm run beauty:recycle:full     # 選定→投稿パイプライン
#
# 人気再投稿（next-repost.json・日次とは別）:
#   node scripts/selectBeautyProduct.cjs --use-repost-next
#
# ※ テスト用に posted-beauty.json を全件埋めないこと（本番在庫を壊す）
# ※ 汚染バックアップ: data/posted-beauty.polluted-backup.json
# ※ テスト在庫: data/posted-beauty.test.json
#
# 日次選定戦略（日付条件）: policy/beauty-select.json（周期・優先順）
# セール期間の一次ソース（自動供給・手動 calendar 運用しない）:
#   data/beauty-sale-windows.json → products-beauty.json の saleStart/saleEnd
#   同期: npm run beauty:sale-sync（run-beauty の選定直前に必ず実行）
#   本番既定: official-page
#   Yahoo: 毎日は見ない。5/15/25/月末だけ軽量確認（日付固定だけでは sale にしない）
#   policy の calendar は補助ミラーのみ（手動で埋めない）
#   必須ではない（未設定でも official-page）。STRICT=true は朝投稿では使わない
BEAUTY_SALE_PROVIDER=official-page
BEAUTY_SALE_YAHOO_CHECK=true
# BEAUTY_SALE_SYNC_STRICT=false
# BEAUTY_SALE_INCLUDE_HTML_COMMENTS=true
# BEAUTY_SALE_UNTIL_LOOKBACK_DAYS=45
# BEAUTY_SALE_MAX_PAGES_PER_BRAND=6
# dry-run: npm run beauty:sale-sync:dry-run / npm run beauty:sale-morning:verify

# カタログ自動補充（公式一覧クロール → candidate queue → 品質ゲート → 適格のみ投入）
# run-beauty の選定直前に実行。失敗しても選定は続行
BEAUTY_INGEST_ENABLED=true
BEAUTY_INGEST_PROMOTE=true
# BEAUTY_INGEST_MAX_DISCOVER=30
# BEAUTY_INGEST_MAX_ENRICH=8
# BEAUTY_INGEST_MAX_PROMOTE=3
# BEAUTY_INGEST_TIMEOUT_MS=12000
# 手動: npm run beauty:ingest / beauty:ingest:dry-run / beauty:ingest:test

# 商品ページURL解決（選定後 → article.product.url。VC LinkSwitch 用の通常URL）
# auto: existing → map → web検索 / map: mapのみ / web|search: 検索
# ※ 楽天・Amazon・Yahoo!ショッピング等のモールURLは成功扱いにしない
PRODUCT_URL_PROVIDER=auto
# 検索チェーン（official=公式サイト直、web=検索フォールバック）
# rakuten は方針外のため指定してもスキップされる
PRODUCT_URL_SEARCH_CHAIN=official,web
# true なら解決失敗で run-beauty を停止（Blogger/SNSに進まない）。緩和時のみ false
PRODUCT_URL_REQUIRE=true
# true なら解決成功時に products-beauty.json と product-url-map.json へ書き戻す
PRODUCT_URL_WRITEBACK=true
PRODUCT_URL_SEARCH_TIMEOUT_MS=15000
# 許可ドメインは scripts/lib/vc-linkswitch-url.cjs を参照

# Blogger 自動公開（OAuth2 refresh token）
# API key だけでは posts.insert できない。Google Cloud で OAuth クライアントを作り、
# scope=https://www.googleapis.com/auth/blogger の refresh_token を用意する。
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
# 任意（公開読取用。投稿には不要）
BLOGGER_API_KEY=

LOG_LEVEL=info
DEFAULT_GENRE=beauty
DEFAULT_STOCK_PROVIDER=pixabay

# Slack 通知（Incoming Webhook）。音はコードでは制御しない → Slack アプリ側でミュート推奨
# Incoming Webhook URL 例: https://hooks.slack.com/services/...
SLACK_WEBHOOK_URL=
# 日次サマリ(info)。true で朝の run-beauty 成功/partial 後に短い1通
SLACK_DAILY_SUMMARY=false
# 一般 warn / info（個別イベントより広い許可。通常は false のまま）
SLACK_NOTIFY_WARN=false
SLACK_NOTIFY_INFO=false
# token / 再投稿の個別 info・warn
SLACK_NOTIFY_TOKEN_OK=false
SLACK_NOTIFY_TOKEN_WARN=false
SLACK_NOTIFY_REPOST_EMPTY=false
SLACK_NOTIFY_REPOST_TOP=false
# Slack 失敗時の macOS バナー（うるさいので既定OFF）
SLACK_MACOS_NOTIFY=false
# LINE Messaging API。自動投稿の失敗（error）だけ push する。
# 長期のチャネルアクセストークンと、受け取る本人のユーザーID（Uで始まる）。
# ボットの基本ID（@から始まる）ではない。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_USER_ID=

# 備蓄期間（food / gadget）。policy/*/ops.json の stockpilePeriod と連動。
# 期間中 Threads/X は STOCKPILE_PAGE_URL（なければ FIXED_PAGE_URL）へ誘導。
# FOOD_STOCKPILE_MODE=true|false で強制ON/OFF可。
# FOOD_STOCKPILE_PAGE_URL=
# FOOD_STOCKPILE_PAGE_ID=
# GADGET_STOCKPILE_PAGE_URL=
# GADGET_STOCKPILE_PAGE_ID=

# ---- 困りごと需要ウォッチ（週1楽天脈拍 → 手動OK）----
# policy/demand-watch.json の辞書を楽天で脈拍。候補化のみで自動切替しない。
# npm run demand:pulse / demand:status / demand:approve -- --theme=stinkbug
# 週次 agent: npm run demand:agent:install （月曜 08:30）

# 簡易ポリシーチェック（policy/rules.json）
# true でチェック自体をスキップ（緊急時のみ）
# POLICY_CHECK_DISABLED=false
# run-beauty 内は --fail-on-block 固定。手動確認時のみ使う:
# POLICY_FAIL_ON_BLOCK=true

# Instagram投稿（Facebook Graph API / graph.facebook.com）
# 投稿前に ensureInstagramAccessToken が動く（App ID/Secret があると期限前に延長を試行）。
# 本命運用: 長期User → Page token（expires_at=0）。USER長期は期限切れ後の無限refresh不可。
#   診断: npx tsx scripts/save-instagram-long-lived-token.ts --diagnose
#   長期化: npx tsx scripts/save-instagram-long-lived-token.ts --short-token='EAA...'
#   Page化: npx tsx scripts/save-instagram-long-lived-token.ts --prefer-page-token
#   定期更新: npm run token:ig-refresh
#   LaunchAgent: bash scripts/install-instagram-token-refresh-agent.sh（日曜 08:30）
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Business Suite 配下で /me/accounts が空のとき、Page ID を直接指定（任意）
FACEBOOK_PAGE_ID=
# true で投稿前/定期ジョブ時に Page token 化を優先
INSTAGRAM_PREFER_PAGE_TOKEN=false
# true で IG caption 末尾に Blogger UTM URL を追加（既定はプロフィール誘導のみで URL なし）
INSTAGRAM_CAPTION_BLOG_UTM=false
# 長期USERの残り日数がこの値以下なら延長を試す（既定14）
INSTAGRAM_TOKEN_RENEW_DAYS=14
# Page 診断: npx tsx scripts/diagnose-instagram-pages.ts
# ※ Business Suite の Page は business_management 付き再認可が必要なことが多い
# Instagram投稿用の固定画像（文字なし）。相対パスは content-studio ルート基準
# ※ beauty自動投稿はテンプレカード生成を優先（固定1枚運用しない）
INSTAGRAM_FIXED_IMAGE=assets/instagram-fixed.jpg
# 許可済み商品画像だけを置くフォルダ（一致しなければ固定画像）
INSTAGRAM_APPROVED_DIR=assets/instagram-approved

# Instagramテンプレカード（タイトル/訴求/ジャンルで自動生成）
# 生成PNGの配置先（リポジトリ直下 instagram-cards を静的公開する想定）
IG_CARD_PUBLIC_DIR=../instagram-cards
# 公開HTTPSベース（末尾スラッシュなし）。未設定だとカード生成後に停止する
IG_CARD_PUBLIC_BASE_URL=
IG_CARD_WIDTH=1080
IG_CARD_HEIGHT=1080
# 生成直後に instagram-cards へ git add/commit/push する（false で無効）
IG_CARD_GIT_PUSH=true
# 日次: 最小カルーセル自動生成（既定3枚）。単枚に戻すなら false
IG_CAROUSEL_ENABLED=true
IG_CAROUSEL_SLIDES=3
# カード画像から縦型の短い動画（Reels / Threads）を作る。false で静止画のまま。
# BGM は assets/reel-audio/*.mp3（Pixabay、ローカルのみ）
SLIDE_REEL=true
# Threads に動画を付けると商品リンクが押しにくくなるため既定は付けない。付けるときだけ true
# THREADS_ATTACH_VIDEO=false

# 美容投稿型: auto=日付ローテ / choose|compare|checklist で固定
# choose=選び方 / compare=比較・見分け / checklist=これだけ見れば
BEAUTY_POST_PATTERN=auto
# 注意: カルーセル/静止画に人気音楽の API 自動付与は不可（Reels + Audio API のみ）

# KPI（いいね以外）: 日次終了後に IG insights + UTM集計
BEAUTY_KPI_ENABLED=true
BEAUTY_KPI_RECENT_DAYS=14
# IG insights には Meta アプリ権限が必要:
#   Facebook Login: instagram_manage_insights
#   または Instagram Login: instagram_business_manage_insights
# 権限が無いと fetch は FAIL ログのみで本線投稿は止まらない
# Threads 固定導線（URL直前のCTA / 任意で固定ハブURL）
BEAUTY_THREADS_FIXED_CTA=▼ ブログでポイントだけ整理
# BEAUTY_THREADS_FIXED_BLOG_URL=https://beauty-diary-30s.blogspot.com/p/xxxxx.html
# ブログ実クリックは GA未連携のため、必要なら output/metrics/utm-click-overrides.json に手動追記
# npm run metrics:ig-insights / metrics:kpi

# Threads 投稿（Instagramとは別アプリ・別トークン）
# テキスト投稿に必要な権限: threads_basic, threads_content_publish
# 再認可時は code → 短命(oauth/access_token) → 長期(th_exchange_token) の順。
# .env に入れるのは必ず長期 token（約60日）。短命(約1時間)を入れないこと。
# 取得: npx tsx scripts/save-threads-long-lived-token.ts --code='...'
# 投稿前に th_refresh_token で自動延長を試行し、成功時は本値を更新する
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://erectroom6345-hub.github.io/instagram-cards/oauth-callback
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# 任意。未設定時は false 扱い（自動フロー接続時用）
THREADS_ENABLED=false
# 任意。既定 v1.0
THREADS_API_VERSION=v1.0

# Threads コメント自動返信（ポーリング。Webhook は未使用）
# 必要権限: threads_read_replies, threads_manage_replies（OAuth 再認可が必要な場合あり）
THREADS_AUTO_REPLY=false
# 返信文（複数推奨・パイプ区切り）。未設定時は内蔵の短文をランダム使用
# 単一文の THREADS_AUTO_REPLY_TEXT も後方互換で可
THREADS_AUTO_REPLY_TEXTS="ありがとうございます。うれしいです。|見てくださって嬉しいです。また遊びにきてくださいね。|コメントありがとうございます。励みになります。|ありがとうございます。またゆっくり見にきてください。|うれしいコメントです。また寄ってくださいね。"
# 返信する条件キーワード（カンマ区切り）。空/未設定ならキーワード条件なしで全件対象
THREADS_REPLY_KEYWORDS=ありがとう,きれ,素敵,参考,試してみ,スキンケア,美容,いいね,応援
# NGワード（カンマ区切り）。THREADS_REPLY_NG_KEYWORDS 優先（旧 NG_WORDS も可）
THREADS_REPLY_NG_KEYWORDS=死ね,殺す,詐欺,クソ,馬鹿,バカ,ゴミ,宣伝,稼げる,LINE追加

# ---- 楽天市場API（living カタログ自動取得）----
# アプリ: https://webservice.rakuten.co.jp/
# アフィリエイトID: https://affiliate.rakuten.co.jp/
# IchibaItem/Search に affiliateId を付けると itemUrl がアフィURLになる
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
# 楽天アプリの「許可されたウェブサイト」と一致する Origin（必須）
# 未設定時は LIVING_FIXED_PAGE_URL の origin を使う
# RAKUTEN_ORIGIN=https://kurashi-soubiroku.blogspot.com
# living 選定前に products-living.json の main[] を自動差し替え（既定 true）
LIVING_RAKUTEN_INGEST_ENABLED=true
# true で main を全置換（sample-shop を残さない）。false は先頭追記
LIVING_RAKUTEN_INGEST_REPLACE_MAIN=true
# 任意（未設定時は policy/living-rakuten-ingest.json + living-ops の価格帯）
# LIVING_RAKUTEN_MIN_PRICE=500
# LIVING_RAKUTEN_MAX_PRICE=5000
# 手動: npm run living:catalog:fetch / living:catalog:check / living:auto:dry-run

# ---- living（暮らし便利グッズ / 楽天アフィリエイト一本）----
# 方針: 楽天APIで main 自動生成 → SNS先行 → 48h伸び判定 → カテゴリまとめ追記
# 完全自動 dry-run: npm run living:auto:dry-run
# dry-runのみ（既存JSON）: LIVING_RAKUTEN_INGEST_ENABLED=false npm run living:dry-run
# 本番SNS: npm run living:run
# 伸び判定: npm run living:growth:apply && npm run living:append:apply
#
# 暮らしまとめブログ用固定ページ（followup用。SNS誘導には使わない。blog誘導は美容のみ）
LIVING_FIXED_PAGE_URL=
#
# 暮らし専用 SNS（美容の INSTAGRAM_* / THREADS_* は触らない）
# run-living.sh が LIVING_* → 共通キーへ差し替え
LIVING_INSTAGRAM_ACCESS_TOKEN=
LIVING_INSTAGRAM_ACCOUNT_ID=
LIVING_FACEBOOK_PAGE_ID=
LIVING_INSTAGRAM_PREFER_PAGE_TOKEN=true
# living IG token 自動延長用（tokenを発行した Meta App と一致させる）
# 未設定でも投稿は可。日曜 08:40 の living:token:refresh でスキップされる
# LIVING_FACEBOOK_APP_ID=
# LIVING_FACEBOOK_APP_SECRET=

LIVING_THREADS_ACCESS_TOKEN=
LIVING_THREADS_USER_ID=
LIVING_THREADS_ENABLED=true
# LIVING_THREADS_APP_ID=
# LIVING_THREADS_APP_SECRET=
# LIVING_THREADS_REDIRECT_URI=https://erectroom6345-hub.github.io/instagram-cards/oauth-callback

# X OAuth 1.0a User Context（Portal → Keys and tokens）
LIVING_X_ENABLED=false
LIVING_X_API_KEY=
LIVING_X_API_SECRET=
LIVING_X_ACCESS_TOKEN=
LIVING_X_ACCESS_TOKEN_SECRET=

# ---- 楽天市場API（gadget も living と同じキーを共有）----
# RAKUTEN_APPLICATION_ID / RAKUTEN_ACCESS_KEY / RAKUTEN_AFFILIATE_ID は上記 living 欄を参照
# gadget 選定前に products-gadget.json の main[] を自動差し替え（既定 true）
# 未設定時は true。CLI で一時オフ: GADGET_RAKUTEN_INGEST_ENABLED=false npm run gadget:dry-run
# （.env に true を書くと export を上書きするので、常時オフにしたい時だけ .env に false）
# GADGET_RAKUTEN_INGEST_ENABLED=true
# true で main を全置換。false は先頭追記
GADGET_RAKUTEN_INGEST_REPLACE_MAIN=true
# 任意（未設定時は policy/gadget-rakuten-ingest.json + gadget-ops の価格帯）
# GADGET_RAKUTEN_MIN_PRICE=800
# GADGET_RAKUTEN_MAX_PRICE=7000
# 手動: npm run gadget:catalog:fetch / gadget:catalog:check / gadget:auto:dry-run

# ---- gadget（ガジェット小物 / 楽天アフィリエイト一本）----
# 方針: 楽天APIで main 自動生成 → SNS先行（IG/Threads/X 完結）→ blogはまとめ専用
# 完全自動 dry-run: npm run gadget:auto:dry-run
# dry-runのみ（既存JSON）: GADGET_RAKUTEN_INGEST_ENABLED=false npm run gadget:dry-run
# 本番SNS: npm run gadget:run
# LaunchAgent: npm run gadget:agent:install（毎日 9:20）
# token更新: npm run gadget:token:install（日曜 08:45）
#
# ガジェットまとめブログ用固定ページ（followup用。SNS誘導には使わない。blog誘導は美容のみ）
GADGET_FIXED_PAGE_URL=
# ガジェットまとめ用 Blogger（OAuth は共通 BLOGGER_CLIENT_* / REFRESH_TOKEN）
# 未設定時は BLOGGER_BLOG_ID にフォールバック（美容ブログへ誤投稿しやすいので専用推奨）
GADGET_BLOGGER_BLOG_ID=
# ブログ初期シード: npm run gadget:seed
# 伸び判定〜追記: npm run gadget:followup / gadget:followup:install（毎日 11:20）
#
# ガジェット専用 SNS（美容 / living のキーは触らない）
# run-gadget.sh が GADGET_* → 共通キーへ差し替え
GADGET_INSTAGRAM_ACCESS_TOKEN=
GADGET_INSTAGRAM_ACCOUNT_ID=
GADGET_FACEBOOK_PAGE_ID=
GADGET_INSTAGRAM_PREFER_PAGE_TOKEN=true
# gadget IG token 自動延長用（tokenを発行した Meta App と一致させる）
# GADGET_FACEBOOK_APP_ID=
# GADGET_FACEBOOK_APP_SECRET=

GADGET_THREADS_ACCESS_TOKEN=
GADGET_THREADS_USER_ID=
GADGET_THREADS_ENABLED=true
# GADGET_THREADS_APP_ID=
# GADGET_THREADS_APP_SECRET=
# GADGET_THREADS_REDIRECT_URI=https://erectroom6345-hub.github.io/instagram-cards/oauth-callback

# X OAuth 1.0a（ガジェットは X 向き。鍵が揃ったら true）
GADGET_X_ENABLED=false
GADGET_X_API_KEY=
GADGET_X_API_SECRET=
GADGET_X_ACCESS_TOKEN=
GADGET_X_ACCESS_TOKEN_SECRET=

# ---- food（旬・手土産の食べ物 / 楽天アフィリエイト一本）----
# 方針: 楽天APIで main 自動生成 → SNS先行（完結）→ blogはまとめ専用
# ご当地・地域紹介は別レーン。希少は arrival/limited の interrupt のみ
# 完全自動 dry-run: npm run food:auto:dry-run
# dry-runのみ（既存JSON）: FOOD_RAKUTEN_INGEST_ENABLED=false npm run food:dry-run
# 本番SNS: npm run food:run
# LaunchAgent: npm run food:agent:install（毎日 9:30）
# token更新: npm run food:token:install（日曜 08:50）
# FOOD_RAKUTEN_INGEST_ENABLED=true
FOOD_RAKUTEN_INGEST_REPLACE_MAIN=true
# まとめブログ用。通常はSNS誘導に使わない。
# 備蓄期間（policy/food-ops.json stockpilePeriod、既定 2026-10-28〜11-30）だけ
# Threads/X に固定ページURLを載せる。強制: FOOD_STOCKPILE_MODE=true|false
FOOD_FIXED_PAGE_URL=
FOOD_BLOGGER_BLOG_ID=
# FOOD_STOCKPILE_MODE=
# FOOD_STOCKPILE_START=2026-10-28
# FOOD_STOCKPILE_END=2026-11-30
# ブログ初期シード: npm run food:seed
# 伸び判定〜追記: npm run food:followup / food:followup:install（毎日 11:30）
#
# 食べ物専用 SNS（他ジャンルのキーは触らない）
# run-food.sh が FOOD_* → 共通キーへ差し替え
FOOD_INSTAGRAM_ACCESS_TOKEN=
FOOD_INSTAGRAM_ACCOUNT_ID=
FOOD_FACEBOOK_PAGE_ID=
FOOD_INSTAGRAM_PREFER_PAGE_TOKEN=true
# FOOD_FACEBOOK_APP_ID=
# FOOD_FACEBOOK_APP_SECRET=

FOOD_THREADS_ACCESS_TOKEN=
FOOD_THREADS_USER_ID=
FOOD_THREADS_ENABLED=true
# FOOD_THREADS_APP_ID=
# FOOD_THREADS_APP_SECRET=
# FOOD_THREADS_REDIRECT_URI=

FOOD_X_ENABLED=false
FOOD_X_API_KEY=
FOOD_X_API_SECRET=
FOOD_X_ACCESS_TOKEN=
FOOD_X_ACCESS_TOKEN_SECRET=

# ---- drink（銘酒・季節酒 / 楽天アフィリエイト一本）----
# 方針: food と同型。産地自慢は顔にしない。希少は interrupt のみ
# 完全自動 dry-run: npm run drink:auto:dry-run
# dry-runのみ: DRINK_RAKUTEN_INGEST_ENABLED=false npm run drink:dry-run
# 本番SNS: npm run drink:run
# LaunchAgent: npm run drink:agent:install（毎日 9:40）
# token更新: npm run drink:token:install（日曜 08:55）
# DRINK_RAKUTEN_INGEST_ENABLED=true
DRINK_RAKUTEN_INGEST_REPLACE_MAIN=true
# まとめブログ用（SNS誘導には使わない。blog誘導は美容のみ）
DRINK_FIXED_PAGE_URL=
DRINK_BLOGGER_BLOG_ID=
# ブログ初期シード: npm run drink:seed
# 伸び判定〜追記: npm run drink:followup / drink:followup:install（毎日 11:40）
#
DRINK_INSTAGRAM_ACCESS_TOKEN=
DRINK_INSTAGRAM_ACCOUNT_ID=
DRINK_FACEBOOK_PAGE_ID=
DRINK_INSTAGRAM_PREFER_PAGE_TOKEN=true
# DRINK_FACEBOOK_APP_ID=
# DRINK_FACEBOOK_APP_SECRET=

DRINK_THREADS_ACCESS_TOKEN=
DRINK_THREADS_USER_ID=
DRINK_THREADS_ENABLED=true
# DRINK_THREADS_APP_ID=
# DRINK_THREADS_APP_SECRET=
# DRINK_THREADS_REDIRECT_URI=

DRINK_X_ENABLED=false
DRINK_X_API_KEY=
DRINK_X_API_SECRET=
DRINK_X_ACCESS_TOKEN=
DRINK_X_ACCESS_TOKEN_SECRET=

# ---- adult-en（Adult EN / DMM / FC2 / X予約）----
# 方針: 半自動。月1回パック生成 → Xの予約投稿に手載せ（無料API自動投稿はしない）
# FC2: 既存JPはそのまま。ENまとめページ（en / en-oho / en-ahegao / en-goods）を追加
# 他ジャンルのキーは触らない・流用しない
#
# X（予約運用。API鍵は不要。HANDLEだけあればよい）
ADULT_EN_X_ENABLED=false
ADULT_EN_X_HANDLE=
ADULT_EN_X_SCHEDULE_HOUR_JST=12:00
# 以下は使わない（将来有料APIにするとき用・今は空でOK）
# ADULT_EN_X_API_KEY=
# ADULT_EN_X_API_SECRET=
# ADULT_EN_X_ACCESS_TOKEN=
# ADULT_EN_X_ACCESS_TOKEN_SECRET=
#
# DMMアフィリエイト（日本語媒体のみ。海外向けX/英語記事には使わない）
ADULT_EN_DMM_AFFILIATE_ID=
# DTI CASH ユーザーID（海外向け映像。広告リンクの u=）
ADULT_EN_DTI_USER_ID=
# 1回だけ。scripts/harvest-dti-offers.py が加盟サイト/CSVを自動取得
ADULT_EN_DTI_PASSWORD=
# ADULT_EN_DMM_AFFILIATE_BASE=
#
# FC2（JP既存 + ENページ予定）
ADULT_EN_FC2_BLOG_URL=https://tatsuportal.blog.fc2.com/
# ADULT_EN_FC2_EN_HUB_URL=
# ADULT_EN_FC2_EN_OHO_URL=
# ADULT_EN_FC2_EN_AHEGAO_URL=
# ADULT_EN_FC2_EN_GOODS_URL=
# ADULT_EN_POSTED_PRODUCTS_PATH=data/posted-adult-en.json

# ---- adult-jp（日本語X / DMM。adult-en とは別アカウント・別ルール）----
# 海外版のハンドル、DTI、英語記事、美人選定は流用しない
# Xは予約運用。API鍵は不要
ADULT_JP_X_ENABLED=false
ADULT_JP_X_HANDLE=
ADULT_JP_X_SCHEDULE_HOUR_JST=21:00
# ADULT_JP_DMM_AFFILIATE_ID=
# ADULT_JP_POSTED_PRODUCTS_PATH=data/posted-adult-jp.json


