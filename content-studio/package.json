{
  "name": "content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blogger向け記事作成支援と、Instagram / Threads / X 下書き生成ツール",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli/index.ts",
    "generate": "tsx src/cli/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "metrics:append": "node scripts/append-post-metrics.cjs --from-summary",
    "metrics:summary": "node scripts/summarize-product-metrics.cjs",
    "metrics:ig-insights": "node scripts/fetch-ig-insights.cjs",
    "metrics:kpi": "node scripts/summarize-kpi.cjs",
    "metrics:kpi:json": "node scripts/summarize-kpi.cjs --json",
    "policy:check": "node scripts/check-policy.cjs",
    "policy:test": "node scripts/test-policy-check.cjs",
    "token:ig-refresh": "tsx scripts/refresh-instagram-token.ts",
    "token:ig-refresh:agent": "bash run-instagram-token-refresh.sh",
    "repost:dry-run": "node scripts/select-repost-candidate.cjs --repost-dry-run",
    "repost:apply": "node scripts/select-repost-candidate.cjs --repost-apply",
    "repost:demo": "node scripts/select-repost-candidate.cjs --repost-dry-run --demo",
    "beauty:select:daily:dry-run": "node scripts/selectBeautyProduct.cjs --mode=daily --dry-run",
    "beauty:select:recycle:dry-run": "node scripts/selectBeautyProduct.cjs --mode=recycle --dry-run",
    "beauty:select:recycle": "node scripts/selectBeautyProduct.cjs --mode=recycle",
    "beauty:recycle": "bash run-beauty-recycle.sh",
    "beauty:recycle:full": "bash run-beauty-recycle.sh --full",
    "beauty:select:test-modes": "node scripts/test-select-beauty-modes.cjs",
    "beauty:select:test-strategy": "node scripts/test-select-beauty-strategy.cjs",
    "beauty:sale-sync": "node scripts/sync-beauty-sale-windows.cjs --provider=official-page",
    "beauty:sale-sync:dry-run": "node scripts/sync-beauty-sale-windows.cjs --provider=official-page --dry-run",
    "beauty:sale-unit": "node scripts/test-beauty-sale-official-page.cjs",
    "beauty:sale-yahoo:test": "node scripts/test-beauty-sale-yahoo.cjs",
    "beauty:sale-morning:verify": "node scripts/verify-beauty-sale-morning.cjs --live",
    "beauty:verify-image-morning": "node scripts/verify-blog-image-and-morning.cjs",
    "beauty:fix-2026-10-07": "node scripts/fix-beauty-posts-2026-10-07.cjs",
    "beauty:prepublish": "node scripts/assert-beauty-prepublish.cjs",
    "beauty:inventory": "node scripts/audit-beauty-inventory.cjs",
    "beauty:ingest": "node scripts/ingest-beauty-catalog.cjs",
    "beauty:ingest:dry-run": "node scripts/ingest-beauty-catalog.cjs --dry-run",
    "beauty:ingest:test": "node scripts/test-beauty-catalog-ingest.cjs",
    "beauty:wake:install": "bash scripts/install-morning-wake.sh",
    "notify:test": "bash scripts/test-slack-notify.sh",
    "notify:summary": "bash scripts/test-slack-notify.sh --summary",
    "utm:test": "node scripts/test-utm.cjs",
    "product-url:resolve": "node scripts/resolveProductUrl.cjs",
    "product-url:dry-run": "node scripts/resolveProductUrl.cjs --dry-run",
    "product-url:test": "node scripts/test-resolve-product-url.cjs",
    "blogger:backfill-affiliate:dry-run": "tsx src/backfillBeautyAffiliateLinks.ts --dry-run",
    "blogger:backfill-affiliate": "tsx src/backfillBeautyAffiliateLinks.ts --apply",
    "threads:repost-today:dry-run": "tsx src/repostThreadsToday.ts --dry-run",
    "threads:repost-today": "tsx src/repostThreadsToday.ts --apply",
    "living:dry-run": "bash run-living.sh --dry-run",
    "living:run": "bash run-living.sh",
    "living:agent:install": "bash scripts/install-living-agent.sh",
    "living:agent:uninstall": "bash scripts/uninstall-living-agent.sh",
    "living:x-token:auth-url": "tsx scripts/save-x-user-access-token.ts --auth-url",
    "living:x-token:exchange": "tsx scripts/save-x-user-access-token.ts",
    "living:x-token:verify": "tsx scripts/verify-x-oauth2-token-exchange.ts",
    "living:select": "node scripts/selectLivingProduct.cjs",
    "living:sample-report": "node scripts/sample-living-report.cjs",
    "living:seed": "node scripts/seed-living-blog.cjs --apply",
    "living:seed:dry-run": "node scripts/seed-living-blog.cjs --dry-run",
    "living:roundups:dry-run": "tsx scripts/publish-living-roundups.ts --dry-run",
    "living:roundups:publish": "tsx scripts/publish-living-roundups.ts --apply",
    "living:growth:dry-run": "node scripts/check-living-growth.cjs --dry-run",
    "living:growth:demo": "node scripts/check-living-growth.cjs --demo",
    "living:growth:apply": "node scripts/check-living-growth.cjs --apply",
    "living:append:dry-run": "node scripts/append-living-blog.cjs --dry-run",
    "living:append:apply": "node scripts/append-living-blog.cjs --apply",
    "repost:living:dry-run": "node scripts/select-repost-candidate.cjs --repost-dry-run --genre=living",
    "repost:living:apply": "node scripts/select-repost-candidate.cjs --repost-apply --genre=living"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "opena": "^0.1.19",
    "openai": "^7.23.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
