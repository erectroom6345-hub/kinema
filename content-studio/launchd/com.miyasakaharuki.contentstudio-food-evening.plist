<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.miyasakaharuki.contentstudio-food-evening</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/caffeinate</string>
      <string>-i</string>
      <string>/bin/bash</string>
      <string>/Users/miyasakaharuki/treasure-shop-hp/content-studio/run-food.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/miyasakaharuki/treasure-shop-hp/content-studio</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>HOME</key>
      <string>/Users/miyasakaharuki</string>
      <key>CONTENT_PIPELINE_GENRE</key>
      <string>food</string>
      <key>POSTED_PRODUCTS_PATH</key>
      <string>data/posted-food.json</string>
      <key>FOOD_X_ENABLED</key>
      <string>false</string>
      <key>THREADS_AUTO_REPLY</key>
      <string>false</string>
      <key>OLLAMA_CAPTION_FALLBACK</key>
      <string>true</string>
      <!-- 夜枠試験: 同じ垢・口調だけ変える（別アカウントにしない） -->
      <key>FOOD_POST_SLOT</key>
      <string>evening</string>
    </dict>

    <!-- food朝 9:30 の2本目試験。朝ジャンル群とぶつからない夜枠 -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>40</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/miyasakaharuki/treasure-shop-hp/content-studio/output/food-evening-cron.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/miyasakaharuki/treasure-shop-hp/content-studio/output/food-evening-cron.log</string>

    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
