<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.miyasakaharuki.instagram-token-refresh</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/miyasakaharuki/treasure-shop-hp/content-studio/run-instagram-token-refresh.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/miyasakaharuki/treasure-shop-hp/content-studio</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>HOME</key>
      <string>/Users/miyasakaharuki</string>
    </dict>

    <!-- 週1回（日曜 08:30）。残日数閾値以下のときだけ実際に交換する -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Weekday</key>
      <integer>0</integer>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/miyasakaharuki/treasure-shop-hp/content-studio/output/instagram-token-refresh.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/miyasakaharuki/treasure-shop-hp/content-studio/output/instagram-token-refresh.log</string>

    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
